# ESP32-S31 Korvo-1 — devkit-specific settings.
#
# Applied after the project-root sdkconfig.defaults (later file wins). Wired in
# CMakePresets.json, whose korvo1 preset names this file in SDKCONFIG_DEFAULTS —
# IDF does not auto-load a defaults file with this name.

# Selected devkit — must match the DEVKIT the devkit preset sets.
CONFIG_DEVKIT_KORVO1=y

# Custom partition table — this devkit's own layout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="devkits/korvo1/partitions.csv"

# Flash size — Korvo-1 has 16 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# PSRAM — 16 MB Octal PSRAM; required for RGB display buffers.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# Camera sensor — SC101IOT on the DVP interface (this board's fitted module).
# The SC101IOT has DVP modes at 1280x720 YUV 4:2:2 only; camera_korvo1.cpp
# decimates that 4:1 in software to 320x180 for both the detector and the LCD.
CONFIG_CAMERA_SC101IOT=y
CONFIG_CAMERA_SC101IOT_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_1280X720_15FPS=y
CONFIG_CAMERA_SC101IOT_DVP_DEFAULT_FMT_YUV422_1280X720_15FPS=y

# The stock Korvo-1 sensor (OV3660) is turned off. To go back to it, drop the
# SC101IOT block above and this line, and use (camera_korvo1.cpp handles both):
#   CONFIG_CAMERA_OV3660=y
#   CONFIG_CAMERA_OV3660_DVP_RGB565_BE_240X240_24FPS=y
#   CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_RGB565_BE_240X240_24FPS=y
# CONFIG_CAMERA_OV3660 is not set
